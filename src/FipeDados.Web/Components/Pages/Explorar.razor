@page "/consultar-tabela-fipe"
@rendermode InteractiveServer
@implements IDisposable
@inject ICatalogService Catalog
@inject NavigationManager Nav
@inject ILogger<Explorar> Logger
@inject PublicCatalog PublicCatalog
@inject OfertaPlano Oferta
<SeoMetadata Title="Consultar Tabela Fipe: preços de carros e motos | VALORDAFIPE"
             Description="Consulte o preço de referência de carros e motos por marca, modelo e ano. Veja o histórico da Tabela Fipe e a variação dos valores disponíveis."
             Path="/consultar-tabela-fipe" Breadcrumbs="crumbs" />
<div class="consulta-intro">
    <div class="consulta-intro-copy">
        <div class="explore-heading"><h1>Consulte a Tabela Fipe <span>de carros e motos</span></h1><p>Encontre o preço de referência de carros e motos por marca, modelo e ano.</p></div>
    </div>
    <AnuncioMock Posicao="consulta-cabecalho" Compacto="true" />
</div>
<section class="vehicle-search-panel" aria-labelledby="search-heading">
    <div class="search-panel-heading"><div><span class="panel-eyebrow">CONSULTA PERSONALIZADA</span><h2 id="search-heading">Qual veículo você quer consultar?</h2></div><span class="search-panel-badge"><Icon Name="shield" Size="15" /> Referência Fipe</span></div>
    <div class="vehicle-type-label">Comece pelo tipo de veículo</div>
    <div class="vehicle-type-picker" role="group" aria-label="Tipo de veículo">
        <button class="@(tipo == TipoVeiculo.Carro ? "selected" : "")" aria-pressed="@(tipo == TipoVeiculo.Carro)" @onclick="() => TrocarTipo(TipoVeiculo.Carro)"><Icon Name="car" Size="25" /><span>Carros<small>Do primeiro carro ao próximo.</small></span><span class="type-radio">@if (tipo == TipoVeiculo.Carro) { <span></span> }</span></button>
        <button class="@(tipo == TipoVeiculo.Moto ? "selected" : "")" aria-pressed="@(tipo == TipoVeiculo.Moto)" @onclick="() => TrocarTipo(TipoVeiculo.Moto)"><Icon Name="bike" Size="25" /><span>Motos<small>Liberdade em duas rodas.</small></span><span class="type-radio">@if (tipo == TipoVeiculo.Moto) { <span></span> }</span></button>
    </div>
    <div class="selection-fields">
        <SearchSelect Label="Marca" Step="01" Items="MarcasComTodas" Value="marcaId" ValueChanged="TrocarMarca" Loading="carregandoMarcas" Placeholder="Escolha a marca" Hint="Busque pelo nome da fabricante" />
        <SearchSelect Label="Modelo" Step="02" Value="modeloId" ValueChanged="TrocarModelo" SearchProvider="PesquisarModelos" SearchContext="@((tipo, marcaId))" SearchEmpty="@(marcaId > 0)" SelectedItem="modeloSelecionado" Placeholder="Escolha ou pesquise o modelo" Hint="@(marcaId == 0 ? "Pesquise o modelo ou selecione uma marca" : "Pesquise os modelos desta marca")" />
        <SearchSelect Label="Ano / combustível" Step="03" Items="anos" @bind-Value="veiculoId" Loading="carregandoAnos" Disabled="@(modeloId == 0 || anos.Count == 0)" Placeholder="Escolha o ano" Hint="@(modeloId == 0 ? "Selecione um modelo primeiro" : "Escolha o ano e a motorização")" />
    </div>
    @if (erro is not null) { <div class="notice error-notice" role="alert"><Icon Name="info" /><span>@erro</span><button class="text-button" @onclick="RepetirEtapa">Tentar novamente</button></div> }
    <div class="search-panel-footer"><div class="selection-progress" aria-live="polite"><span class="progress-track"><span style="@($"width: {(veiculoId > 0 ? 100 : modeloId > 0 ? 66 : marcaId > 0 ? 33 : 0)}%")"></span></span><span>@(veiculoId > 0 ? "Tudo pronto para consultar" : "Selecione marca, modelo e ano")</span></div><button class="btn btn-primary" disabled="@(veiculoId == 0 || abrindoVeiculo)" @onclick="VerVeiculo">Ver preços e variação <Icon Name="arrow" Size="18" /></button></div>
</section>
<div class="search-context"><Icon Name="info" Size="16" /><span>Ao abrir o veículo, os meses que faltam no histórico são consultados automaticamente na Fipe. Os preços já disponíveis são reutilizados.</span></div>
<section class="explore-benefits" aria-label="O que você vai encontrar">
    <div><span class="benefit-icon"><Icon Name="car" Size="22" /></span><h3>O valor de referência</h3><p>O preço da Tabela Fipe para a combinação exata de modelo e ano.</p></div>
    <div><span class="benefit-icon"><Icon Name="chart" Size="22" /></span><h3>O movimento dos preços</h3><p>Até 24 meses de histórico para enxergar tendências com mais clareza.</p></div>
    <div><span class="benefit-icon"><Icon Name="clock" Size="22" /></span><h3>Mais contexto para decidir</h3><p>Variações mensais, mínimas e máximas em uma visão completa.</p></div>
</section>
@code {
    private static readonly IReadOnlyList<SeoBreadcrumb> crumbs = [new("Início", "/"), new("Consultar Tabela Fipe", "/consultar-tabela-fipe")];
    private TipoVeiculo tipo = TipoVeiculo.Carro;
    private int marcaId, modeloId, veiculoId, versao;
    private IReadOnlyList<ItemSelecao> marcas = [], anos = [];
    private IReadOnlyList<ItemSelecao> MarcasComTodas => [new(0, "Todas as marcas"), ..marcas];
    private readonly Dictionary<int, ModeloEncontrado> modelosEncontrados = [];
    private ItemSelecao? modeloSelecionado;
    private CancellationTokenSource? carregamento;
    private bool carregandoMarcas, carregandoAnos, abrindoVeiculo, descartado;
    private string? erro;
    private Func<Task>? repetir;
    protected override async Task OnInitializedAsync()
    {
        var requisicao = NovaEtapa();
        try
        {
            var resultado = await PublicCatalog.CachedBrands(tipo, carregamento!.Token);
            if (requisicao != versao || descartado) return;
            marcas = resultado;
            if (marcas.Count == 0) { erro = "As marcas ainda não estão na base. Clique em tentar novamente para consultar a fonte."; repetir = CarregarMarcas; }
        }
        catch (OperationCanceledException) when (requisicao != versao || descartado) { }
        catch (Exception ex) { Falhou(ex, requisicao, "as marcas", CarregarMarcas); }
    }
    private async Task TrocarTipo(TipoVeiculo valor)
    {
        if (tipo == valor && (carregandoMarcas || (marcas.Count > 0 && erro is null))) return;
        tipo = valor; marcaId = modeloId = veiculoId = 0;
        marcas = anos = []; modeloSelecionado = null; modelosEncontrados.Clear();
        await CarregarMarcas();
    }
    private async Task CarregarMarcas()
    {
        var requisicao = NovaEtapa();
        carregandoMarcas = true;
        try { var resultado = await Catalog.ObterMarcasAsync(tipo, carregamento!.Token); if (requisicao == versao && !descartado) { marcas = resultado; if (marcas.Count == 0) { erro = "As marcas ainda não estão disponíveis. Tente novamente em instantes."; repetir = CarregarMarcas; } } }
        catch (OperationCanceledException) when (requisicao != versao || descartado) { }
        catch (Exception ex) { Falhou(ex, requisicao, "as marcas", CarregarMarcas); }
        finally { if (requisicao == versao) carregandoMarcas = false; }
    }
    private Task TrocarMarca(int valor)
    {
        if (marcaId == valor) return Task.CompletedTask;
        NovaEtapa();
        marcaId = valor; modeloId = veiculoId = 0; anos = []; modeloSelecionado = null; modelosEncontrados.Clear();
        return Task.CompletedTask;
    }
    private async Task<ResultadoPesquisaSelecao> PesquisarModelos(string termo, CancellationToken ct)
    {
        var tipoBusca = tipo;
        var marcaBusca = marcaId;
        var resultado = await Catalog.PesquisarModelosAsync(tipoBusca, termo, marcaBusca > 0 ? marcaBusca : null, ct);
        ct.ThrowIfCancellationRequested();
        if (descartado || tipoBusca != tipo || marcaBusca != marcaId) throw new OperationCanceledException(ct);
        modelosEncontrados.Clear();
        foreach (var modelo in resultado.Itens) modelosEncontrados[modelo.Id] = modelo;
        return new(resultado.Itens.Select(m => new ItemSelecao(m.Id, marcaBusca == 0 ? $"{m.MarcaNome} — {m.Nome}" : m.Nome)).ToArray(), resultado.TemMais);
    }
    private async Task TrocarModelo(int valor)
    {
        if (!modelosEncontrados.TryGetValue(valor, out var modelo)) return;
        marcaId = modelo.MarcaId; modeloId = modelo.Id;
        modeloSelecionado = new(modelo.Id, modelo.Nome);
        if (!marcas.Any(m => m.Id == marcaId)) marcas = [..marcas, new(marcaId, modelo.MarcaNome)];
        await CarregarAnos();
    }
    private async Task CarregarAnos()
    {
        var requisicao = NovaEtapa();
        var id = modeloId;
        veiculoId = 0; anos = []; carregandoAnos = true;
        try { var resultado = await Catalog.ObterAnosAsync(id, carregamento!.Token); if (requisicao == versao && !descartado) { anos = resultado; if (anos.Count == 0) { erro = "Nenhum ano disponível para este modelo no momento."; repetir = CarregarAnos; } } }
        catch (OperationCanceledException) when (requisicao != versao || descartado) { }
        catch (Exception ex) { Falhou(ex, requisicao, "os anos", CarregarAnos); }
        finally { if (requisicao == versao) carregandoAnos = false; }
    }
    private int NovaEtapa()
    {
        ++versao; carregamento?.Cancel(); carregamento?.Dispose(); carregamento = new();
        carregandoMarcas = carregandoAnos = false; erro = null; repetir = null;
        return versao;
    }
    private Task RepetirEtapa() => repetir?.Invoke() ?? Task.CompletedTask;
    private void Falhou(Exception ex, int requisicao, string etapa, Func<Task> tentar)
    {
        if (requisicao != versao || descartado) return;
        Logger.LogError(ex, "Falha ao carregar {Etapa}.", etapa);
        erro = $"Não foi possível carregar {etapa}. Tente novamente."; repetir = tentar;
    }
    public void Dispose()
    {
        descartado = true; ++versao; carregamento?.Cancel(); carregamento?.Dispose();
    }
    private async Task VerVeiculo()
    {
        if (veiculoId == 0 || abrindoVeiculo) return;
        abrindoVeiculo = true;
        try
        {
            if (await PublicCatalog.VehiclePath(veiculoId) is { } caminho)
            {
                Nav.NavigateTo(caminho, new NavigationOptions { HistoryEntryState = Oferta.RegistrarPesquisa(caminho) });
                return;
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Falha ao abrir o veículo {Id}.", veiculoId); }
        abrindoVeiculo = false;
        erro = "Não foi possível abrir este veículo. Tente novamente.";
        repetir = VerVeiculo;
    }
}
