@page "/consultar-tabela-fipe"
@using System.Text.Json
@inject PublicCatalog PublicCatalog
<SeoMetadata Title="Consultar Tabela Fipe: preços de carros e motos | VALORDAFIPE"
             Description="Consulte o preço de referência de carros e motos por marca, modelo e ano. Veja o histórico da Tabela Fipe e a variação dos valores disponíveis."
             Path="/consultar-tabela-fipe" Breadcrumbs="crumbs" />
<div class="consulta-intro">
    <div class="consulta-intro-copy">
        <div class="explore-heading"><h1>Consulte a Tabela Fipe <span>de carros e motos</span></h1><p>Encontre o preço de referência de carros e motos por marca, modelo e ano.</p></div>
    </div>
    <Anuncio Posicao="consulta-cabecalho" Compacto="true" />
</div>
<fipe-consulta data-carros="@JsonSerializer.Serialize(carros, json)" data-motos="@JsonSerializer.Serialize(motos, json)">
<section class="vehicle-search-panel" aria-labelledby="search-heading">
    <div class="search-panel-heading"><div><span class="panel-eyebrow">CONSULTA PERSONALIZADA</span><h2 id="search-heading">Qual veículo você quer consultar?</h2></div><span class="search-panel-badge"><Icon Name="shield" Size="15" /> Referência Fipe</span></div>
    <div class="vehicle-type-label">Comece pelo tipo de veículo</div>
    <div class="vehicle-type-picker" role="radiogroup" aria-label="Tipo de veículo">
        <label><input class="visually-hidden" type="radio" name="tipo-consulta" value="1" checked /><Icon Name="car" Size="25" /><span>Carros<small>Do primeiro carro ao próximo.</small></span><span class="type-radio"><span></span></span></label>
        <label><input class="visually-hidden" type="radio" name="tipo-consulta" value="2" /><Icon Name="bike" Size="25" /><span>Motos<small>Liberdade em duas rodas.</small></span><span class="type-radio"><span></span></span></label>
    </div>
    <div class="selection-fields">
        <ConsultaSelect Campo="marca" Label="Marca" Step="01" Placeholder="Todas as marcas" Hint="Busque pelo nome da fabricante" />
        <ConsultaSelect Campo="modelo" Label="Modelo" Step="02" Placeholder="Escolha ou pesquise o modelo" Hint="Pesquise o modelo ou selecione uma marca" />
        <ConsultaSelect Campo="ano" Label="Ano / combustível" Step="03" Disabled="true" Placeholder="Escolha o ano" Hint="Selecione um modelo primeiro" />
    </div>
    <div class="notice error-notice" role="alert" data-erro hidden><Icon Name="info" /><span></span><button type="button" class="text-button" data-repetir>Tentar novamente</button></div>
    <div class="search-panel-footer"><div class="selection-progress" aria-live="polite"><span class="progress-track"><span style="width: 0%"></span></span><span data-progresso>Selecione marca, modelo e ano</span></div><a class="btn btn-primary" data-consultar aria-disabled="true" tabindex="-1">Ver preços e variação <Icon Name="arrow" Size="18" /></a></div>
    <noscript><p class="notice">Ative o JavaScript para pesquisar ou <a href="/catalogo">navegue pelo catálogo de marcas e modelos</a>.</p></noscript>
</section>
</fipe-consulta>
<section class="explore-benefits" aria-label="O que você vai encontrar">
    <div><span class="benefit-icon"><Icon Name="car" Size="22" /></span><h3>O valor de referência</h3><p>O preço da Tabela Fipe para a combinação exata de modelo e ano.</p></div>
    <div><span class="benefit-icon"><Icon Name="chart" Size="22" /></span><h3>O movimento dos preços</h3><p>Até 24 meses de histórico para enxergar tendências com mais clareza.</p></div>
    <div><span class="benefit-icon"><Icon Name="clock" Size="22" /></span><h3>Mais contexto para decidir</h3><p>Variações mensais, mínimas e máximas em uma visão completa.</p></div>
</section>
@code {
    private static readonly IReadOnlyList<SeoBreadcrumb> crumbs = [new("Início", "/"), new("Consultar Tabela Fipe", "/consultar-tabela-fipe")];
    private static readonly JsonSerializerOptions json = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<ItemSelecao> carros = [], motos = [];
    protected override async Task OnInitializedAsync()
    {
        var carregarCarros = PublicCatalog.CachedBrands(TipoVeiculo.Carro);
        var carregarMotos = PublicCatalog.CachedBrands(TipoVeiculo.Moto);
        await Task.WhenAll(carregarCarros, carregarMotos);
        carros = await carregarCarros;
        motos = await carregarMotos;
    }
}
