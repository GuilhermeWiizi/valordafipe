@page "/"
@attribute [OutputCache(PolicyName = PaginaCache.Politica)]
@inject IRankingService Ranking
@inject ILogger<Home> Logger

<SeoMetadata Title="Tabela Fipe: preços e histórico de carros e motos | VALORDAFIPE"
             Description="Consulte a Tabela Fipe de carros e motos, acompanhe até 24 meses de preços e compare a valorização ou desvalorização dos veículos na VALORDAFIPE." />
<section class="home-hero">
    <div class="hero-copy"><h1>Tabela Fipe.<br />O preço e sua <span>história.</span></h1><p>Consulte preços de carros e motos e acompanhe<br class="desktop-break" /> até 24 meses de variação da Tabela Fipe.</p><a class="btn btn-primary" href="consultar-tabela-fipe"><Icon Name="search" Size="18" /> Consultar Tabela Fipe <Icon Name="arrow" Size="18" /></a></div>
    <Anuncio Posicao="home-destaque" Destaque="true">
        <Fallback>
            <div class="hero-visual" aria-hidden="true"><div class="visual-grid"></div><span class="visual-label"><span class="status-dot"></span> CADA MÊS CONTA</span><div class="visual-number">24<span>meses de história.</span></div><svg class="hero-chart" viewBox="0 0 380 110" fill="none"><defs><linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#7ce8b8" stop-opacity=".23" /><stop offset="1" stop-color="#7ce8b8" stop-opacity="0" /></linearGradient></defs><path d="M0 91L28 79 55 51 84 73 120 42 147 61 175 29 204 49 233 17 263 43 292 14 322 35 353 5 380 8V110H0Z" fill="url(#chartFill)"/><path d="M0 91L28 79 55 51 84 73 120 42 147 61 175 29 204 49 233 17 263 43 292 14 322 35 353 5 380 8" stroke="#7ce8b8" stroke-width="2.5" stroke-linejoin="miter"/></svg></div>
        </Fallback>
    </Anuncio>
</section>
<ChamadaPlano />
<section class="market-section" aria-labelledby="ranking-title">
    <div class="section-heading"><div><div class="page-eyebrow">MOVIMENTOS DO MÊS</div><h2 id="ranking-title">Quem subiu. Quem caiu.</h2></div><nav class="segmented-control" aria-label="Filtrar ranking por tipo"><a class="@(tipo is null ? "selected" : "")" aria-current="@(tipo is null ? "true" : null)" href="@Filtro(null)">Todos</a><a class="@(tipo == TipoVeiculo.Carro ? "selected" : "")" aria-current="@(tipo == TipoVeiculo.Carro ? "true" : null)" href="@Filtro(TipoVeiculo.Carro)"><Icon Name="car" Size="16" /> Carros</a><a class="@(tipo == TipoVeiculo.Moto ? "selected" : "")" aria-current="@(tipo == TipoVeiculo.Moto ? "true" : null)" href="@Filtro(TipoVeiculo.Moto)"><Icon Name="bike" Size="16" /> Motos</a></nav></div>
    @if (erro)
    {
        <div class="notice error-notice" role="alert"><Icon Name="info" /><span>Não foi possível carregar o ranking.</span><a class="text-button" href="@Filtro(tipo)">Tentar novamente</a></div>
    }
    else
    {
        <div class="rankings-grid"><RankingCard Alta="true" Carregando="false" SemComparacao="@(ranking?.VeiculosComparados == 0)" Itens="@(ranking?.Altas ?? [])" /><RankingCard Alta="false" Carregando="false" SemComparacao="@(ranking?.VeiculosComparados == 0)" Itens="@(ranking?.Baixas ?? [])" /></div>
        @if (ranking?.VeiculosComparados > 0)
        {
            <Anuncio Posicao="home-entre-rankings" />
        }
        <BrandDepreciationRanking Itens="@(ranking?.MarcasComMaiorDesvalorizacao ?? [])" Referencia="ranking?.Referencia" Tipo="tipo" Carregando="false" SemComparacao="@(ranking?.VeiculosComparados == 0)" />
    }
</section>
@if (!erro && ranking?.VeiculosComparados > 0)
{
    <Anuncio Posicao="home-apos-rankings" />
}
<section class="explore-banner"><span class="banner-icon"><Icon Name="search" Size="25" /></span><div><h3>Tem um veículo em mente?</h3><p>Encontre o preço atual e veja como ele mudou ao longo do tempo.</p></div><a class="btn btn-outline-primary" href="consultar-tabela-fipe">Fazer uma consulta <Icon Name="arrow" Size="17" /></a></section>
@code {
    // SSR estático: o filtro é um link (?tipo=carros|motos), então cada variação vai pronta para o OutputCache.
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoQuery { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private RankingMensal? ranking;
    private TipoVeiculo? tipo;
    private bool erro;
    protected override async Task OnParametersSetAsync()
    {
        tipo = CatalogPaths.ParseType(TipoQuery);
        erro = false;
        try { ranking = await Ranking.ObterMensalAsync(tipo); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar ranking mensal.");
            ranking = null;
            erro = true;
            PaginaCache.NaoArmazenar(HttpContext);
        }
    }
    private static string Filtro(TipoVeiculo? valor) => (valor is { } t ? $"/?tipo={CatalogPaths.Type(t)}" : "/") + "#ranking-title";
}
