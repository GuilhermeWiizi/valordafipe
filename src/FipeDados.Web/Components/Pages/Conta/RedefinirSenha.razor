@page "/conta/redefinir-senha"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<Usuario> UserManager
@inject NavigationManager Nav

<SeoMetadata Title="Criar nova senha | VALORDAFIPE" Description="Crie uma nova senha para sua conta na VALORDAFIPE." Path="/conta/redefinir-senha" NoIndex="true" />
<ContaCartao Titulo="Criar nova senha" Texto="Confirme o e-mail da conta e escolha a nova senha." Icone="shield" Erros="erros" Sucesso="@sucesso">
    @if (token is not null && sucesso is null)
    {
        <EditForm Model="Input" method="post" OnValidSubmit="RedefinirAsync" OnInvalidSubmit="Input.LimparSenhas" FormName="redefinir-senha" class="account-form">
            <DataAnnotationsValidator />
            <label for="email">E-mail</label>
            <InputText id="email" type="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
            <ValidationMessage For="() => Input.Email" />
            <label for="senha">Nova senha</label>
            <InputText id="senha" type="password" @bind-Value="Input.Senha" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.Senha" />
            <label for="confirmacao">Confirme a nova senha</label>
            <InputText id="confirmacao" type="password" @bind-Value="Input.Confirmacao" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.Confirmacao" />
            <button type="submit" class="btn btn-primary">Salvar nova senha</button>
        </EditForm>
    }
    <div class="account-links">
        @if (sucesso is null)
        {
            <a href="/conta/esqueci-senha">Pedir um novo link</a>
        }
        <a href="@ContaUrls.Entrar">Entrar</a>
    </div>
</ContaCartao>

@code {
    private const string Caminho = "/conta/redefinir-senha", CookieCodigo = "vf_redefinir";
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "codigo")] private string? Codigo { get; set; }
    [SupplyParameterFromForm] private Dados Input { get; set; } = default!;
    private string? token;
    private IReadOnlyList<string> erros = [];
    private string? sucesso;

    protected override void OnInitialized()
    {
        Input ??= new();
        // O código sai da URL antes de a página carregar: analytics, histórico e referrer nunca o veem.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && Codigo is not null)
        {
            HttpContext.Response.Cookies.Append(CookieCodigo, Codigo, new CookieOptions
            {
                Path = Caminho, MaxAge = ContasExtensions.ValidadeLinkSenha, HttpOnly = true,
                Secure = HttpContext.Request.IsHttps, SameSite = SameSiteMode.Lax, IsEssential = true
            });
            Nav.NavigateTo(Caminho);
            return;
        }
        token = Decodificar(HttpContext.Request.Cookies[CookieCodigo]);
        if (token is null) erros = ["Link inválido ou incompleto. Peça um novo link."];
    }

    private async Task RedefinirAsync()
    {
        if (token is null) return;
        var usuario = await UserManager.FindByEmailAsync(Input.Email.Trim());
        var senha = Input.Senha;
        Input.LimparSenhas();
        // Sem conta para o e-mail: mesma resposta de sucesso, para não revelar quais e-mails existem.
        if (usuario is not null)
        {
            var resultado = await UserManager.ResetPasswordAsync(usuario, token, senha);
            if (!resultado.Succeeded)
            {
                erros = resultado.Errors.Select(e => e.Description).Distinct().ToList();
                return;
            }
            // Quem recebeu o link provou ser dono do e-mail: libera um bloqueio por tentativas.
            await UserManager.SetLockoutEndDateAsync(usuario, null);
            await UserManager.ResetAccessFailedCountAsync(usuario);
        }
        HttpContext.Response.Cookies.Delete(CookieCodigo, new CookieOptions { Path = Caminho });
        sucesso = "Senha redefinida. Entre com a nova senha.";
    }

    private static string? Decodificar(string? codigo)
    {
        if (string.IsNullOrEmpty(codigo)) return null;
        try { return Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(codigo)); }
        catch (FormatException) { return null; }
    }

    private sealed class Dados
    {
        [Required(ErrorMessage = "Informe o e-mail."), EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Informe a nova senha."), DataType(DataType.Password)]
        [StringLength(100, MinimumLength = ContasExtensions.TamanhoMinimoSenha, ErrorMessage = "A senha precisa ter de {2} a {1} caracteres.")]
        public string Senha { get; set; } = "";

        [DataType(DataType.Password), Compare(nameof(Senha), ErrorMessage = "As senhas não conferem.")]
        public string Confirmacao { get; set; } = "";

        // O SSR devolveria o value dos campos de senha no HTML; nunca reexibir senha.
        public void LimparSenhas() => Senha = Confirmacao = "";
    }
}
