@page "/tabela-fipe/{Tipo}/{MarcaSlug}/{ModeloSlug}/{AnoSlug}"
@using System.Globalization
@using FipeDados.Core.Fipe
@attribute [OutputCache(PolicyName = PaginaCache.Politica)]
@inject IPrecoService Preco
@inject PublicCatalog Catalog
@inject NavigationManager Nav
@inject IOptions<AnunciosOptions> Anuncios
@* SSR estático com o que já está no banco (rápido, indexável e cacheável). Só os pedaços
   que precisam do servidor depois do carregamento viram ilhas interativas. *@

<SeoMetadata Title="@SeoTitle" Description="@SeoDescription" Path="@(detalhe is null ? "" : CatalogPaths.Vehicle(detalhe))"
             NoIndex="@(detalhe?.Resumo is not { ValorAtual: > 0 })" Breadcrumbs="crumbs" />
<Breadcrumbs Items="crumbs" />

@if (detalhe is null)
{
    <div class="alert alert-warning">Veículo não encontrado ou sem dados disponíveis.</div>
    <a href="consultar-tabela-fipe" class="btn btn-outline-primary">← Voltar para a consulta</a>
}
else
{
    <a href="consultar-tabela-fipe" class="btn btn-link ps-0">← Consultar outro veículo</a>
    <a href="@($"/comparar?a={detalhe.VeiculoId}")" class="btn btn-outline-primary ms-2"><Icon Name="compare" Size="16" /> Comparar este veículo</a>
    <h1 class="veiculo-titulo">Tabela Fipe: @detalhe.Marca @detalhe.Modelo @Ano</h1>
    <p class="text-muted veiculo-sub">
        @Ano · @detalhe.Tipo
        @if (!string.IsNullOrEmpty(detalhe.CodigoFipe))
        {
            <span>· Código Fipe <strong>@detalhe.CodigoFipe</strong></span>
        }
    </p>

    @if (historicoIncompleto)
    {
        <ColetaHistorico @rendermode="InteractiveServer" VeiculoId="detalhe.VeiculoId" Meses="MesesHistorico" />
    }

    @if (detalhe.Resumo is { } r)
    {
        <div class="cards-resumo">
            <div class="card-resumo destaque">
                <span class="rotulo">Último preço disponível</span>
                <span class="valor">@Moeda(r.ValorAtual)</span>
                <span class="sub">@r.MesReferencia</span>
            </div>
            <div class="card-resumo">
                <span class="rotulo">Entre as últimas cotações</span>
                <span class="valor @Cor(r.VariacaoMesPct)">@Pct(r.VariacaoMesPct)</span>
                <span class="sub">@(r.VariacaoMesValor is { } mv ? Moeda(mv, sinal: true) : "—")</span>
            </div>
            <div class="card-resumo">
                <span class="rotulo">Aproximadamente 12 meses</span>
                <span class="valor @Cor(r.Variacao12mPct)">@Pct(r.Variacao12mPct)</span>
            </div>
            <div class="card-resumo">
                <span class="rotulo">No período</span>
                <span class="valor @Cor(r.VariacaoPeriodoPct)">@Pct(r.VariacaoPeriodoPct)</span>
            </div>
        </div>

        <VehicleHistory Detail="detalhe" />

        <div class="cards-stats">
            <div class="stat">
                <span class="rotulo">Mínimo</span>
                <span class="valor">@Moeda(r.Minimo)</span>
                <span class="sub">@r.DataMinimo.ToString("MM/yyyy")</span>
            </div>
            <div class="stat">
                <span class="rotulo">Máximo</span>
                <span class="valor">@Moeda(r.Maximo)</span>
                <span class="sub">@r.DataMaximo.ToString("MM/yyyy")</span>
            </div>
            <div class="stat">
                <span class="rotulo">Média</span>
                <span class="valor">@Moeda(r.Media)</span>
            </div>
        </div>

        @if (r.ValorAtual > 0)
        {
            <AnuncioMock Posicao="veiculo-apos-estatisticas" />
        }
    }
    else if (!historicoIncompleto)
    {
        <div class="alert alert-info">Ainda não há histórico de preço disponível para este veículo no período consultado.</div>
    }
    <RelatedVehicles Detail="detalhe" />
    <section class="seo-copy"><h2>Sobre os preços de @detalhe.Marca @detalhe.Modelo</h2><p>Os valores correspondem a @Ano, conforme a referência de cada mês. O preço de compra ou venda pode variar com conservação, região e outras condições. A base pode ter cobertura parcial e os meses ausentes não são estimados.</p><p><a href="@CatalogPaths.Model(detalhe.Tipo, detalhe.MarcaSlug, detalhe.ModeloSlug)">Ver outros anos deste modelo</a> · <a href="@CatalogPaths.Brand(detalhe.Tipo, detalhe.MarcaSlug)">Ver modelos @detalhe.Marca</a> · <a href="/sobre">Fontes e metodologia</a></p></section>
}

@if (Anuncios.Value.ExibirMock)
{
    @* Demonstração do plano: a oferta precisa do circuito (estado da pesquisa e JS). *@
    <OfertaSemAnuncios @rendermode="InteractiveServer" @key="rotaAtual" Pesquisa="true" ResultadoDisponivel="@(detalhe?.Resumo is { ValorAtual: > 0 })"
                      Caminho="@(detalhe is null ? "/consultar-tabela-fipe" : CatalogPaths.Vehicle(detalhe))" />
}

@code {
    private const int MesesHistorico = 24;
    [Parameter] public string Tipo { get; set; } = "";
    [Parameter] public string MarcaSlug { get; set; } = "";
    [Parameter] public string ModeloSlug { get; set; } = "";
    [Parameter] public string AnoSlug { get; set; } = "";
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");

    private DetalheVeiculo? detalhe;
    private bool historicoIncompleto;
    private string? rotaAtual;
    private IReadOnlyList<SeoBreadcrumb> crumbs = [];
    private string Ano => detalhe is null ? "" : FipeParsing.RotuloAno(detalhe.AnoLabel);
    private string SeoTitle => detalhe is null ? "Veículo | VALORDAFIPE"
        : detalhe.Resumo is { } atual
            ? $"Tabela Fipe {detalhe.Modelo} {Ano}: R$ {atual.ValorAtual.ToString("N2", Pt)} em {atual.MesReferencia} e histórico de preços"
            : $"Tabela Fipe {detalhe.Modelo} {Ano}: histórico de preços";
    private string SeoDescription => detalhe is null ? "Consulte os preços e o histórico de veículos na VALORDAFIPE."
        : $"Tabela Fipe de {detalhe.Marca} {detalhe.Modelo} {Ano}. "
          + (detalhe.Resumo is { } resumo ? $"Último preço disponível: {Moeda(resumo.ValorAtual)} ({resumo.MesReferencia}). Veja o histórico mensal e a variação." : "Veja a disponibilidade do histórico de preços na base.");

    protected override async Task OnParametersSetAsync()
    {
        rotaAtual = $"/tabela-fipe/{Tipo}/{MarcaSlug}/{ModeloSlug}/{AnoSlug}".ToLowerInvariant();
        var token = HttpContext?.RequestAborted ?? default;
        var id = CatalogPaths.ParseType(Tipo) is { } tipo
            ? await Catalog.VehicleId(tipo, MarcaSlug.ToLowerInvariant(), ModeloSlug.ToLowerInvariant(), AnoSlug.ToLowerInvariant(), token) ?? 0
            : 0;
        detalhe = id == 0 ? null : await Preco.ObterDetalheEmCacheAsync(id, token);
        if (detalhe is null) { Nav.NotFound(); return; }
        historicoIncompleto = detalhe.Serie.Count < MesesHistorico;
        // Ilhas interativas carregam marcadores que expiram; histórico incompleto vai mudar em seguida.
        if (historicoIncompleto || Anuncios.Value.ExibirMock) PaginaCache.NaoArmazenar(HttpContext);
        crumbs = [new("Início", "/"), new("Marcas", "/catalogo"),
            new(detalhe.Marca, CatalogPaths.Brand(detalhe.Tipo, detalhe.MarcaSlug)),
            new(detalhe.Modelo, CatalogPaths.Model(detalhe.Tipo, detalhe.MarcaSlug, detalhe.ModeloSlug)),
            new(Ano, CatalogPaths.Vehicle(detalhe))];
    }

    private static string Moeda(decimal v, bool sinal = false)
    {
        var s = v.ToString("C2", Pt);
        return sinal && v > 0 ? "+" + s : s;
    }

    private static string Pct(decimal? p)
        => p is null ? "—" : $"{(p.Value >= 0 ? "+" : "")}{p.Value.ToString("0.0", Pt)}%";

    private static string Cor(decimal? p)
        => p is null ? "" : p.Value >= 0 ? "alta" : "baixa";
}
