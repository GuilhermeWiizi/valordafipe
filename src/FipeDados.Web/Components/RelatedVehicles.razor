@using System.Globalization
@inject IVeiculosRelacionadosService Service
@inject ILogger<RelatedVehicles> Logger
@inject NavigationManager Nav

<section class="related-vehicles" aria-labelledby="other-years-heading">
    <header class="related-heading"><div><span class="related-eyebrow">O MESMO MODELO, OUTRAS POSSIBILIDADES</span><h2 id="other-years-heading">Quanto muda de um ano para outro?</h2><p>Outros anos e combustíveis de @Detail.Marca @Detail.Modelo.</p></div><a href="@CatalogPaths.Model(Detail.Tipo, Detail.MarcaSlug, Detail.ModeloSlug)">Ver todos <Icon Name="arrow" Size="15" /></a></header>
    @if (erro) { <div class="notice" role="status">Não foi possível carregar as alternativas. <a class="text-button" href="@Nav.Uri">Tentar novamente</a></div> }
    else if (dados is { } r)
    {
        <div class="related-year-grid">
        @foreach (var v in r.OutrosAnos)
        {
            <article class="related-year @(v.Id == Detail.VeiculoId ? "current-year" : "")"><span>@v.AnoExibicao</span><strong>@Moeda(v.Preco)</strong><small>@(v.Id == Detail.VeiculoId ? "Veículo selecionado" : v.Preco is null ? "Sem preço nesta referência" : $"{Moeda(v.DiferencaValor, true)} em relação a este")</small><div>@if (v.Id == Detail.VeiculoId) { <span class="related-selected"><Icon Name="check" Size="13" /> Atual</span> } else { <a href="@CatalogPaths.Vehicle(v)">Ver histórico</a><a href="@($"/comparar?a={Detail.VeiculoId}&b={v.Id}")">Comparar <Icon Name="compare" Size="13" /></a> }</div></article>
        }
        </div><p class="related-reference"><Icon Name="calendar" Size="14" />@(r.Referencia is { } data ? $"Preços de {data.ToString("MMMM/yyyy", Pt)}. Compare o valor de cada ano na mesma referência." : "Sem preço de referência para este veículo na base.")</p>
        <header class="related-heading similar-heading"><div><span class="related-eyebrow">OUTRAS OPÇÕES NO MESMO ORÇAMENTO</span><h2>O que mais cabe nessa faixa?</h2><p>@(r.PrecoBase is { } preco ? $"Veículos com preço até 10% acima ou abaixo de {preco.ToString("C0", Pt)}." : "Alternativas com preço próximo ao deste veículo.")</p></div><span class="related-cache-label">Na nossa base</span></header>
        @if (r.PrecosSemelhantes.Count == 0) { <div class="related-empty"><Icon Name="search" Size="25" /><div><h3>Ainda não encontramos alternativas nessa faixa.</h3><p>Os preços precisam estar disponíveis na mesma referência. <a href="/consultar-tabela-fipe">Consulte outros veículos.</a></p></div></div> }
        else
        {
            <div class="similar-grid">@foreach (var v in r.PrecosSemelhantes) { <article class="similar-card"><span class="similar-brand">@v.Marca</span><h3><a href="@CatalogPaths.Vehicle(v)">@v.Modelo</a></h3><span class="similar-year">@v.AnoExibicao</span><div class="similar-price"><strong>@Moeda(v.Preco)</strong><small>@Moeda(v.DiferencaValor, true) de diferença</small></div><a class="similar-compare" href="@($"/comparar?a={Detail.VeiculoId}&b={v.Id}")">Comparar com este <Icon Name="compare" Size="15" /></a></article> }</div>
        }
        <p class="related-note"><Icon Name="info" Size="14" /> Alternativas do mesmo tipo de veículo, em @(r.Referencia?.ToString("MMMM/yyyy", Pt) ?? "referência indisponível"). Faixa de preço não implica equivalência de equipamentos ou estado de conservação. A cobertura da base pode ser parcial.</p>
    }
</section>
@code {
    [Parameter, EditorRequired] public DetalheVeiculo Detail { get; set; } = default!;
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
    private VeiculosRelacionados? dados;
    private bool erro;
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    // SSR estático, renderizado junto com a página do veículo.
    protected override async Task OnParametersSetAsync()
    {
        erro = false;
        try { dados = await Service.ObterAsync(Detail.VeiculoId, HttpContext?.RequestAborted ?? default); }
        catch (Exception ex) when (HttpContext?.RequestAborted.IsCancellationRequested != true)
        {
            Logger.LogWarning(ex, "Falha ao carregar veículos relacionados.");
            erro = true;
            PaginaCache.NaoArmazenar(HttpContext); // A falha não fica em cache para os próximos visitantes.
        }
    }
    private static string Moeda(decimal? valor, bool sinal = false) => valor is { } v ? (sinal && v > 0 ? "+" : "") + v.ToString("C2", Pt) : "—";
}
