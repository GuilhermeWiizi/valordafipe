@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="search-select @(aberto ? "is-open" : "") @(Value > 0 ? "has-value" : "") @(Disabled || Loading ? "is-disabled" : "")" @onkeydown="Tecla">
    <label id="@(id + "-label")" for="@id" class="field-label"><span class="field-step">@Step</span>@Label @if (Value > 0) { <Icon Name="check" Class="field-check" Size="14" /> }</label>
    <button @ref="gatilho" id="@id" type="button" class="select-trigger" aria-labelledby="@(id + "-label " + id + "-value")" aria-haspopup="listbox" aria-expanded="@aberto" aria-controls="@(id + "-options")" disabled="@(Disabled || Loading)" @onclick="Alternar">
        <span id="@(id + "-value")">@(Loading ? "Carregando…" : Items.FirstOrDefault(x => x.Id == Value)?.Nome ?? Placeholder)</span>
        @if (Loading) { <span class="small-spinner" aria-hidden="true"></span> } else { <Icon Name="chevron" Size="17" Class="select-chevron" /> }
    </button>
    <small class="field-hint">@Hint</small>
    @if (aberto && !Disabled && !Loading)
    {
        <button type="button" class="select-backdrop" tabindex="-1" aria-label="Fechar opções de @Label" @onclick="Fechar"></button>
        <div class="select-dropdown">
            <div class="select-search"><Icon Name="search" Size="16" /><input @ref="busca" @bind="termo" @bind:event="oninput" @bind:after="AtualizarFiltro" placeholder="Buscar @Label.ToLowerInvariant()…" aria-label="Buscar @Label.ToLowerInvariant()" role="combobox" aria-expanded="true" aria-autocomplete="list" aria-controls="@(id + "-options")" aria-activedescendant="@(filtrados.Count > 0 ? $"{id}-option-{filtrados[indice].Id}" : null)" /></div>
            <div id="@(id + "-options")" class="select-options" role="listbox" aria-labelledby="@(id + "-label")">
                @foreach (var item in filtrados)
                {
                    <button @key="item.Id" id="@($"{id}-option-{item.Id}")" type="button" role="option" aria-selected="@(item.Id == Value)" tabindex="-1" class="select-option @(filtrados[indice].Id == item.Id ? "highlighted" : "")" @onclick="() => Selecionar(item.Id)"><span>@item.Nome</span>@if (item.Id == Value) { <Icon Name="check" Size="16" /> }</button>
                }
                @if (filtrados.Count == 0) { <div class="select-no-results">Nenhum resultado para “@termo”.</div> }
            </div>
            <div class="select-dropdown-footer">@(total > 80 ? $"{total} opções · refine a busca para ver mais" : $"{total} opções disponíveis")<span>↑ ↓ navegar · Enter selecionar</span></div>
        </div>
    }
</div>
@code {
    [Parameter] public IReadOnlyList<ItemSelecao> Items { get; set; } = [];
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Step { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Selecione";
    [Parameter] public string Hint { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    private readonly string id = "select-" + Guid.NewGuid().ToString("N");
    private ElementReference busca, gatilho;
    private bool aberto, focar, rolar;
    private IJSObjectReference? modulo;
    private string termo = "";
    private int indice, total;
    private List<ItemSelecao> filtrados = [];
    protected override void OnParametersSet()
    {
        if (Disabled || Loading) aberto = false;
        AtualizarFiltro();
    }
    private void AtualizarFiltro()
    {
        var resultado = Items.Where(i => CultureInfo.GetCultureInfo("pt-BR").CompareInfo.IndexOf(i.Nome, termo, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0).ToList();
        total = resultado.Count; filtrados = resultado.Take(80).ToList(); indice = 0; rolar = true;
    }
    private void Alternar() { aberto = !aberto; if (aberto) { termo = ""; AtualizarFiltro(); focar = true; } }
    private void Fechar() => aberto = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!aberto) return;
        modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/search-select.js");
        if (focar) { focar = false; await modulo.InvokeVoidAsync("prepare", busca); await busca.FocusAsync(); }
        if (rolar) { rolar = false; await modulo.InvokeVoidAsync("scrollActive", busca); }
    }
    private async Task Selecionar(int valor)
    {
        aberto = false;
        await gatilho.FocusAsync();
        await ValueChanged.InvokeAsync(valor);
    }
    private async Task Tecla(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Tab") { aberto = false; if (e.Key == "Escape") await gatilho.FocusAsync(); }
        else if (aberto && e.Key == "ArrowDown" && filtrados.Count > 0) { indice = (indice + 1) % filtrados.Count; rolar = true; }
        else if (aberto && e.Key == "ArrowUp" && filtrados.Count > 0) { indice = (indice + filtrados.Count - 1) % filtrados.Count; rolar = true; }
        else if (aberto && e.Key == "Home") { indice = 0; rolar = true; }
        else if (aberto && e.Key == "End" && filtrados.Count > 0) { indice = filtrados.Count - 1; rolar = true; }
        else if (aberto && e.Key == "Enter" && filtrados.Count > 0) await Selecionar(filtrados[indice].Id);
    }
    public async ValueTask DisposeAsync()
    {
        if (modulo is null) return;
        try { await modulo.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
