@inject IOptions<AnunciosOptions> Anuncios

@if (exibirMock)
{
    <aside class="ad-preview @Modificadores" aria-label="Publicidade demonstrativa" data-ad-placement="@Posicao">
        <div class="ad-preview-label"><span>Publicidade</span><span class="ad-preview-badge">Demonstração</span></div>
        <div class="ad-preview-creative">
            <span class="ad-preview-symbol" aria-hidden="true"><Icon Name="car" Size="34" /></span>
            <div class="ad-preview-copy">
                <span class="ad-preview-brand">AUTO EXEMPLO · ANUNCIANTE FICTÍCIO</span>
                <p class="ad-preview-title">Seu próximo carro começa com uma boa escolha.</p>
                <p class="ad-preview-description">Um exemplo de anúncio para você avaliar este espaço.</p>
            </div>
            <span class="ad-preview-action" aria-hidden="true">Conhecer opções <Icon Name="external" Size="14" /></span>
        </div>
    </aside>
}
else if (bloco is not null)
{
    @* display: contents mantém o espaço como item do grid/flex da página. Sem anúncio para
       o espaço (data-ad-status="unfilled"), o bloco some e o conteúdo original volta. *@
    <div class="ad-host">
        <aside class="ad-preview ad-real @Modificadores" aria-label="Publicidade" data-ad-placement="@Posicao">
            <div class="ad-preview-label"><span>Publicidade</span></div>
            <ins class="adsbygoogle" style="display:block" data-ad-client="@Anuncios.Value.AdSenseClientId" data-ad-slot="@bloco"
                 data-ad-format="auto" data-full-width-responsive="true"></ins>
        </aside>
        @if (Fallback is not null)
        {
            <div class="ad-fallback">@Fallback</div>
        }
    </div>
}
else
{
    @Fallback
}

@code {
    [Parameter, EditorRequired] public string Posicao { get; set; } = "";
    [Parameter] public bool Destaque { get; set; }
    [Parameter] public bool Compacto { get; set; }
    [Parameter] public RenderFragment? Fallback { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private bool exibirMock;
    private string? bloco;
    private string Modificadores => $"{(Destaque ? "ad-preview--hero" : "")} {(Compacto ? "ad-preview--compact" : "")}";

    protected override async Task OnParametersSetAsync()
    {
        var semAnuncios = PlanoUsuario.SemAnuncios((await AuthenticationState).User, DateTime.UtcNow);
        exibirMock = Anuncios.Value.ExibirMock && !semAnuncios;
        bloco = semAnuncios ? null : Anuncios.Value.Bloco(Posicao);
    }
}
