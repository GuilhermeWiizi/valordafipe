@using FipeDados.Core.Fipe
@inject IPrecoService Preco
@inject NavigationManager Nav
@inject ILogger<ColetaHistorico> Logger
@implements IDisposable
@* Ilha interativa da página (SSR) do veículo: só existe enquanto faltam meses no histórico.
   Busca na Fipe depois de conectar e, com meses novos, pede ao servidor a página atualizada. *@

@if (atualizando)
{
    <div class="history-update" role="status" aria-live="polite"><span class="small-spinner"></span><p>Consultando na Fipe os meses que faltam no histórico…</p></div>
}

@code {
    [Parameter, EditorRequired] public int VeiculoId { get; set; }
    [Parameter] public int Meses { get; set; } = 24;

    private readonly CancellationTokenSource lifetime = new();
    private bool atualizando = true;
    private bool iniciada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No prerender não há OnAfterRender: a consulta só começa com o circuito conectado.
        if (iniciada) return;
        iniciada = true;
        var token = lifetime.Token;
        var tentativa = 0;
        var temNovosMeses = false;
        try
        {
            while (true)
            {
                Exception? falha;
                try
                {
                    var coleta = await Preco.CompletarHistoricoAsync(VeiculoId, Meses, token, reconsultarLacunas: false);
                    token.ThrowIfCancellationRequested();
                    temNovosMeses |= coleta.Consultados > 0;
                    falha = coleta.Falha;
                }
                catch (Exception ex) when (ex is not OperationCanceledException || !token.IsCancellationRequested)
                {
                    Logger.LogWarning(ex, "Falha ao atualizar histórico do veículo {Id}; nova tentativa automática.", VeiculoId);
                    falha = ex;
                }

                token.ThrowIfCancellationRequested();
                if (atualizando) { atualizando = false; StateHasChanged(); }
                if (falha is null or FipeAcessoHistoricoException)
                {
                    // Mostra também os meses salvos antes de uma restrição de acesso permanente.
                    if (temNovosMeses) Nav.Refresh();
                    return;
                }

                // A espera não bloqueia o circuito: navegar e consultar os dados existentes continua possível.
                var atraso = TimeSpan.FromSeconds(Math.Min(300, 30 * Math.Pow(2, Math.Min(tentativa++, 4))));
                if (falha is FipeLimiteException { RetryAfter: { } espera } && espera > atraso) atraso = espera;
                await AguardarNovaTentativaAsync(atraso, token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    protected virtual Task AguardarNovaTentativaAsync(TimeSpan atraso, CancellationToken ct) => Task.Delay(atraso, ct);

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
