@using System.Globalization
@using System.Text.Json
@* SSR estático: a tabela completa vai no HTML (SEO e sem JS). Gráfico, período e medida
   ficam com o elemento <fipe-historico> (wwwroot/js/historico.js), sem circuito no servidor. *@
<section class="vehicle-history" aria-labelledby="history-heading">
    <header class="history-heading"><div><span class="history-eyebrow">COTAÇÃO A COTAÇÃO</span><h2 id="history-heading">A história por trás do preço</h2><p data-historico-resumo>@Resumo(linhas)</p></div><div class="segmented-control" role="group" aria-label="Período do histórico"><button type="button" data-periodo="6" aria-pressed="false">6 meses</button><button type="button" data-periodo="12" aria-pressed="false">12 meses</button><button type="button" class="selected" data-periodo="" aria-pressed="true">Todo o histórico</button></div></header>
    <div class="history-chart-toolbar"><span><Icon Name="chart" Size="16" /><span data-historico-medida>Preço de referência em reais</span></span><div class="segmented-control" role="group" aria-label="Medida do histórico"><button type="button" class="selected" data-medida="preco" aria-pressed="true">Preço (R$)</button><button type="button" data-medida="variacao" aria-pressed="false">Variação (%)</button></div></div>
    <div class="history-chart"><fipe-historico data-serie="@serieJson" role="img" aria-label="@($"Gráfico do preço Fipe de {Detail.Marca} {Detail.Modelo} {Detail.AnoLabel}")"></fipe-historico></div>
    @if (Detail.Resumo is { ValorAtual: > 0 })
    {
        <AnuncioMock Posicao="veiculo-apos-grafico" />
    }
    <div class="history-table-heading"><div><h3>Variação mês a mês</h3><p>Acompanhe cada movimento e a mudança acumulada no período.</p></div><a class="btn btn-outline-primary" href="@CsvUrl" download="@($"historico-fipe-{Detail.VeiculoId}.csv")" data-historico-csv><Icon Name="external" Size="14" /> Baixar CSV</a></div>
    <div class="history-table-scroll"><table class="table history-table"><caption>Histórico da Tabela Fipe de @Detail.Marca @Detail.Modelo @Detail.AnoLabel. Acumulado desde <span data-historico-desde>@(linhas.FirstOrDefault(l => l.Valor > 0)?.Data.ToString("MM/yyyy") ?? "—")</span>.</caption><thead><tr><th scope="col">REFERÊNCIA</th><th scope="col">PREÇO FIPE</th><th scope="col">NO MÊS (%)</th><th scope="col">NO MÊS (R$)</th><th scope="col">ACUMULADA (%)</th></tr></thead><tbody>
        @for (var i = linhas.Count - 1; i >= 0; i--)
        {
            var linha = linhas[i];
            <tr data-indice="@i"><th scope="row">@linha.Mes</th><td>@Moeda(linha.Valor)</td><td class="@Cor(linha.VariacaoMesPct)">@Pct(linha.VariacaoMesPct)</td><td class="@Cor(linha.VariacaoMesValor)">@Moeda(linha.VariacaoMesValor, true)</td><td class="@Cor(linha.VariacaoAcumuladaPct)" data-acumulada>@Pct(linha.VariacaoAcumuladaPct)</td></tr>
        }
    </tbody></table></div><p class="history-note"><Icon Name="info" Size="15" /> A variação mensal usa o mês imediatamente anterior, inclusive quando ele está fora do filtro. Acumulada: primeira cotação válida do período. — indica dado ausente; preços não são estimados.</p>
</section>

@code {
    [Parameter, EditorRequired] public DetalheVeiculo Detail { get; set; } = default!;
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
    private IReadOnlyList<LinhaHistorico> linhas = [];
    private string serieJson = "[]";

    protected override void OnParametersSet()
    {
        linhas = HistoricoMensalCalculator.Calcular(Detail.Serie);
        // Rótulos já formatados em pt-BR: o navegador só recalcula o acumulado do período.
        serieJson = JsonSerializer.Serialize(linhas.Select(l => new
        {
            d = l.Data.ToString("yyyy-MM"),
            r = l.Data.ToString("MMM/yy", Pt),
            m = l.Data.ToString("MM/yyyy"),
            v = l.Valor,
            pm = l.VariacaoMesPct,
            vm = l.VariacaoMesValor
        }));
    }

    private static string Resumo(IReadOnlyList<LinhaHistorico> linhas) => linhas.Count == 0
        ? "Aguardando preços disponíveis."
        : $"{linhas[0].Data:MM/yyyy} a {linhas[^1].Data:MM/yyyy} · {linhas.Count(l => l.Valor is not null)} meses com preço";
    private string CsvUrl => "data:text/csv;charset=utf-8," + Uri.EscapeDataString("﻿Referência;Preço FIPE;Variação mensal (%);Variação mensal (R$);Variação acumulada (%)\r\n" + string.Join("\r\n", linhas.Reverse().Select(l => string.Join(";", l.Data.ToString("yyyy-MM"), Numero(l.Valor), Numero(l.VariacaoMesPct), Numero(l.VariacaoMesValor), Numero(l.VariacaoAcumuladaPct)))));
    private static string Numero(decimal? valor) => valor?.ToString("0.00", Pt) ?? "";
    private static string Moeda(decimal? valor, bool sinal = false) => valor is { } v ? (sinal && v > 0 ? "+" : "") + v.ToString("C2", Pt) : "—";
    private static string Pct(decimal? valor) => valor is { } v ? v.ToString("+0.00;-0.00;0.00", Pt) + "%" : "—";
    private static string Cor(decimal? valor) => valor > 0 ? "history-up" : valor < 0 ? "history-down" : "";
}
