# Credenciais locais. Troque a senha antes de publicar em um servidor.
# Use letras e numeros na senha para evitar delimitadores da connection string.
POSTGRES_USER=fipe
POSTGRES_PASSWORD=fipe
POSTGRES_DB=fipedados
FIPE_PARALLELUM_HABILITADA=false
POSTGRES_PORT=5432
WEB_PORT=8080
COLETA_MENSAL_HABILITADA=true

# A aplicacao exige uma origem HTTPS para canonicals e links de recuperacao de senha.
SEO_SITE_URL=https://valordafipe.com.br
# Mantenha false em testes; use true ao publicar no dominio oficial com HTTPS.
SEO_ALLOW_INDEXING=false

# Opcionais: recuperacao de senha por e-mail e configuracao da conta de anuncios.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE="VALORDAFIPE <nao-responda@valordafipe.com.br>"
ADSENSE_CLIENT_ID=ca-pub-3765938973361380

# Compatibilidade com Pix direto (legado). Novas compras usam MP_HABILITADO.
PIX_HABILITADO=false
PIX_ADMINISTRADOR_ID=
PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE_RECEBEDOR=
PLANO_MENSAL=9.90
PLANO_TRIMESTRAL=27.90
PLANO_SEMESTRAL=49.90
PLANO_ANUAL=89.90

# Novas contratações: Pix automático pelo Mercado Pago. Segredos apenas neste arquivo local.
MP_HABILITADO=false
MP_PRODUCAO=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_VENDEDOR_ID=
MP_URL_PUBLICA=https://valordafipe.com.br
MP_CHAVE_PIX_CADASTRADA=false
# Somente com MP_PRODUCAO=false: APRO faz o Mercado Pago aprovar o Pix de teste automaticamente.
MP_NOME_PAGADOR_TESTE=
