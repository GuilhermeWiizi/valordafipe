# Gere uma senha no servidor com: openssl rand -hex 32
# Configure antes da primeira execucao. A senha de um banco existente nao muda por aqui.
POSTGRES_PASSWORD=
WEB_PORT=8082
# Limites de CPU e memória dos contêineres (docker compose deploy.resources.limits).
WEB_CPUS=1.5
WEB_MEMORY=1g
DB_CPUS=1.0
DB_MEMORY=768m
COLETA_MENSAL_HABILITADA=true
SEO_SITE_URL=https://valordafipe.com.br
SEO_ALLOW_INDEXING=false
# Nginx no host: use o gateway exibido pelo docker inspect do container web.
TRUSTED_PROXY_IP=127.0.0.1

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE="VALORDAFIPE <nao-responda@valordafipe.com.br>"
ADSENSE_CLIENT_ID=ca-pub-3765938973361380
# true habilita os mesmos anuncios demonstrativos e oferta de plano do ambiente local.
ADS_EXIBIR_MOCK=false

# Compatibilidade com Pix direto (legado). Novas compras usam MP_HABILITADO.
PIX_HABILITADO=false
PIX_ADMINISTRADOR_ID=
PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE_RECEBEDOR=
PLANO_MENSAL=9.90
PLANO_TRIMESTRAL=27.90
PLANO_SEMESTRAL=49.90
PLANO_ANUAL=89.90

# Novas contratações: Pix automático pelo Mercado Pago. Segredos apenas neste arquivo local.
MP_HABILITADO=false
MP_PRODUCAO=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_VENDEDOR_ID=
MP_URL_PUBLICA=https://valordafipe.com.br
MP_CHAVE_PIX_CADASTRADA=false
